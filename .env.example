# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pro plan: $14/mo single venue
STRIPE_PRO_PRICE_ID=price_...
# Locations plan: $24/mo for up to 5 published pages
STRIPE_LOCATIONS_PRICE_ID=price_...
# Bundle add-on: +$9/mo when sold via ReviewReply
STRIPE_BUNDLE_PRICE_ID=price_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) — optional, welcome emails skipped if missing ---
RESEND_API_KEY=re_...
EMAIL_FROM=MenuLink <hello@menulink.page>

# --- Bundle integration with ReviewReply ---
# Shared secret used by ReviewReply backend to call /api/bundle/provision.
# Must match exactly across both apps. Rotate quarterly.
# See specs/2026-04-09-reviewreply-bundle-contract.md
BUNDLE_SHARED_SECRET=long-random-string
